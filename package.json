    "provenance": true
  },
  "dependencies": {
    "@opencode/plugin": "2.0.30"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.2"
  }
}
